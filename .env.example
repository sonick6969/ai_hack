# Пути разрешаются относительно каталога, из которого запущен backend.
DATABASE_PATH=./data/pilot.sqlite3
# Локальный разбор работает без внешних запросов. LLM включается явно.
LLM_ENABLED=false
OPENAI_API_KEY=
# Укажите доступную вашей учётной записи модель с Responses API и Structured Outputs.
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=3
# true — использовать HTTP(S)_PROXY / ALL_PROXY из окружения; схема прокси должна поддерживаться httpx.
LLM_TRUST_ENV=false
